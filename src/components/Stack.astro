<section class="border-t border-zinc-900 bg-zinc-900/10 py-16">
  <div class="max-w-5xl mx-auto px-4">
    <h2 class="text-center text-xs font-mono tracking-widest text-zinc-500 uppercase mb-10">
      Toolbox Técnico & Competências
    </h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      <div class="space-y-2">
        <h3 class="text-sm font-mono text-zinc-300 font-bold">// Linguagens</h3>
        <p class="text-xs text-zinc-400 font-sans">Python, C/C++, JavaScript/TypeScript, PHP, SQL</p>
      </div>
      <div class="space-y-2">
        <h3 class="text-sm font-mono text-zinc-300 font-bold">// Web & APIs</h3>
        <p class="text-xs text-zinc-400 font-sans">React.js, Next.js, Nest.js, Node.js, FastAPI, Flask, RESTful Architecture</p>
      </div>
      <div class="space-y-2">
        <h3 class="text-sm font-mono text-zinc-300 font-bold">// Bancos de Dados</h3>
        <p class="text-xs text-zinc-400 font-sans">PostgreSQL, MySQL, Oracle, SQLite, Firebase, DynamoDB</p>
      </div>
      <div class="space-y-2">
        <h3 class="text-sm font-mono text-zinc-300 font-bold">// Hardware & Infra</h3>
        <p class="text-xs text-zinc-400 font-sans">Microcontroladores PIC/ARM, ESP32, Arduino, CAN Bus, Git</p>
      </div>
    </div>
  </div>
</section>

